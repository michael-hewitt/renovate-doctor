{
  "name": "renovate-doctor",
  "version": "0.0.0",
  "private": true,
  "description": "When a Renovate PR fails CI, an agent fixes and merges it, reruns it, or declines it with a trip wire.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
